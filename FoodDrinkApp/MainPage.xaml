<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="NutriBite">
    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light=#F4F8F6, Dark=#071B1F}">

        <Grid Padding="18,16,18,18"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="14"
              BackgroundColor="{AppThemeBinding Light=#0E3B43, Dark=#061216}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="NutriBite"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Food intelligence dashboard"
                           FontSize="14"
                           TextColor="#BFE8E0" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="+"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        FontSize="26"
                        Padding="0"
                        BackgroundColor="#FFE45E"
                        TextColor="#0E3B43"
                        Clicked="OnAddClicked"
                        SemanticProperties.Hint="Add a new food or drink record" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border StrokeThickness="0" BackgroundColor="#163F47" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="12" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                        <Label Text="items" FontSize="12" TextColor="#BFE8E0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#163F47" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="7" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                        <Label Text="hardware" FontSize="12" TextColor="#BFE8E0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#163F47" Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="WCAG" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                        <Label Text="ready" FontSize="12" TextColor="#BFE8E0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    StrokeThickness="1"
                    Stroke="#2B616B"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#09252B}"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <SearchBar x:Name="SearchFoodBar"
                           Placeholder="Search matcha, breakfast, drink..."
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"
                           TextColor="{AppThemeBinding Light=#0E2D33, Dark=#F4FFFD}"
                           PlaceholderColor="{AppThemeBinding Light=#6A858A, Dark=#9BBCC2}"
                           BackgroundColor="Transparent"
                           SemanticProperties.Hint="Search the food and drink list" />
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching food or drink records."
                            Margin="18,18,18,16">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="14" Margin="0,0,0,14">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border StrokeThickness="0" BackgroundColor="#0E3B43" Padding="14,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="All" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="13" />
                                </Border>
                                <Border StrokeThickness="1" Stroke="#D5E4E2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B2A31}" Padding="14,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="Breakfast" TextColor="{AppThemeBinding Light=#0E3B43, Dark=#DFF9F3}" FontAttributes="Bold" FontSize="13" />
                                </Border>
                                <Border StrokeThickness="1" Stroke="#D5E4E2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B2A31}" Padding="14,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="Drinks" TextColor="{AppThemeBinding Light=#0E3B43, Dark=#DFF9F3}" FontAttributes="Bold" FontSize="13" />
                                </Border>
                                <Border StrokeThickness="1" Stroke="#D5E4E2" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B2A31}" Padding="14,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="High protein" TextColor="{AppThemeBinding Light=#0E3B43, Dark=#DFF9F3}" FontAttributes="Bold" FontSize="13" />
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <Label Text="Today&apos;s nutrition board"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0E2D33, Dark=#F4FFFD}"
                               SemanticProperties.HeadingLevel="Level2" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#D5E4E2, Dark=#1C4A52}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0A252B}"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Name}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0E2D33, Dark=#F4FFFD}"
                                               SemanticProperties.HeadingLevel="Level2" />
                                        <Label Text="{Binding Category}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#007C89, Dark=#6BE4E6}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#FFE45E, Dark=#614F14}"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding CaloriesLabel}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0E3B43, Dark=#FFF6B2}" />
                                    </Border>
                                </Grid>

                                <Label Grid.Row="1"
                                       Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#587177, Dark=#BDD4D8}"
                                       LineBreakMode="TailTruncation" />

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding ProteinLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#284B63, Dark=#C4E5FF}" />
                                        <ProgressBar Progress="{Binding ProteinProgress}" ProgressColor="#284B63" HeightRequest="6" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding CarbsLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#C46D00, Dark=#FFD08A}" />
                                        <ProgressBar Progress="{Binding CarbsProgress}" ProgressColor="#F5A623" HeightRequest="6" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="{Binding FatLabel}" FontSize="12" TextColor="{AppThemeBinding Light=#8B3A62, Dark=#FFB7D5}" />
                                        <ProgressBar Progress="{Binding FatProgress}" ProgressColor="#B94E80" HeightRequest="6" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding AllergyNote}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#6A858A, Dark=#9BBCC2}"
                                           LineBreakMode="TailTruncation" />
                                    <Button Grid.Column="1"
                                            Text="View"
                                            Padding="16,8"
                                            BackgroundColor="#00A896"
                                            TextColor="#FFFFFF"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnDetailsClicked"
                                            SemanticProperties.Hint="Open nutrition details" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
